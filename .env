# =======================================================
# RESU-GENIE ENVIRONMENT CONFIGURATION
# =======================================================



# -------------------------------------------------------
# AWS REGION
# All AWS services (Bedrock, S3, SQS, OpenSearch, etc.)
# will use this region.
# -------------------------------------------------------
AWS_REGION=us-east-1

# -------------------------------------------------------
# AWS CREDENTIALS
# ⚠️  LOCAL DEVELOPMENT ONLY.
# In production (ECS), IAM Task Roles handle auth automatically.
# These keys are NEVER needed in production — ECS gets
# credentials from IMDS (Instance Metadata Service) via task role.
# See README for IAM role setup.
# -------------------------------------------------------
AWS_ACCESS_KEY_ID=your-local-dev-access-key-id
AWS_SECRET_ACCESS_KEY=your-local-dev-secret-access-key

# -------------------------------------------------------
# AWS S3 — Resume Storage
# -------------------------------------------------------
S3_BUCKET_NAME=resu-genie-resumes

# -------------------------------------------------------
# AWS SQS — Async Resume Processing Queue
# -------------------------------------------------------
SQS_QUEUE_NAME=resu-genie-jobs
SQS_DLQ_NAME=resu-genie-jobs-dlq
# Filled automatically after queue creation:
SQS_QUEUE_URL=

# -------------------------------------------------------
# AWS DYNAMODB — Metadata Store
# -------------------------------------------------------
DYNAMODB_TABLE_NAME=resu-genie-metadata

# -------------------------------------------------------
# AWS BEDROCK — LLM + Embeddings (replaces OpenAI)
# Bedrock uses IAM auth — no separate API key needed!
# Just ensure the ECS task role has bedrock:InvokeModel permission.
# Available models depend on region — request access in AWS Console
# under Bedrock → Model Access before using.
# -------------------------------------------------------
BEDROCK_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# -------------------------------------------------------
# AWS OPENSEARCH SERVERLESS — Vector DB (replaces Pinecone)
# Uses IAM auth — no API key needed in production!
# Collection endpoint is set after provisioning.
# -------------------------------------------------------
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX_NAME=resu-genie-vectors

# -------------------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------------------
APP_PORT=5000
APP_ENV=development
SECRET_KEY=change-this-in-production
MAX_FILE_SIZE_MB=10
